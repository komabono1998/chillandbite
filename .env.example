# Production: set APP_DEBUG=0 so errors are logged to storage/logs instead of shown to visitors
APP_DEBUG=0
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=chillandbite
DB_USER=root
DB_PASS=
# Set MAIL_ENABLED=1 on a server that can send email (tickets, booking and login emails)
MAIL_ENABLED=0
MAIL_FROM=no-reply@chillandbite.local
# Phase 3 (leave blank until the merchant account is approved)
PESAPAL_CONSUMER_KEY=
PESAPAL_CONSUMER_SECRET=

# Optional: signing key for ticket seals (otherwise a random key is kept in storage/app.key; back it up)
APP_KEY=
# Online mobile money payments through Daraza (https://daraza.net). Get the API key from your Daraza dashboard.
# The payment method is picked from the phone number (MTN = 1, Airtel = 2). Leave DARAZA_API_KEY empty to switch online payment off.
# DARAZA_SANDBOX=1 uses Daraza test endpoints (no real money). DARAZA_MOCK=1 pretends to be Daraza on localhost only.
DARAZA_API_KEY=
DARAZA_SANDBOX=0

# Visitor statistics: ANALYTICS=0 switches counting off. GEO_LOOKUP=1 finds each visitor's country through ipwho.is
# (only needed when the host does not already send a country header; the address is never stored, only a scrambled copy for caching)
ANALYTICS=1
GEO_LOOKUP=0
# Optional: first admin created by database/install.php (password of 10+ characters)
ADMIN_EMAIL=
ADMIN_PASSWORD=
